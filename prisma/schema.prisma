// ============================================================
// Goat Organ Billing System — Prisma schema (v2 migration)
//
// Design notes carried over from the v1 (PHP/MySQL) audit:
// - Every entity ID is a `String @id @default(cuid())`, not a bare
//   VARCHAR compared inconsistently as both string and parseInt()
//   throughout the old JS. Prisma's generated TypeScript types make
//   that whole bug class impossible to reintroduce — the compiler
//   rejects comparing a string id to a number.
// - Balance history (RetailerBalance) is the single source of truth
//   for "previous balance" resolution, exactly matching the
//   resolveRetailerBalanceAsOf() logic already proven correct in v1
//   this session — ported to TypeScript in lib/balance.ts, not
//   duplicated per-screen again.
// - All multi-row writes (generating a combined bill, saving many
//   retailers' closing balances at once) MUST run inside a single
//   Prisma $transaction — this is the fix for the "one change causes
//   data to mix and duplicate" class of bug from v1, where a
//   half-completed batch of sequential API calls could leave the
//   database in an inconsistent state.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MandiPeriod {
  tuesday_friday
  saturday_monday
}

enum BillPattern {
  standard
  aurangabad
}

enum CashFlowEntryType {
  transaction
  commission
  expense
  person_payment
  opening_balance
}

enum PaymentMode {
  Cash
  UPI
  Bank
  Cheque
  Other
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  email        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

// Replaces the old api_keys table's raw-string-in-header approach with
// standard signed session tokens (see lib/auth.ts) — same idea (a
// bearer token, expiring, revocable) but handled by a vetted library
// instead of hand-rolled hash comparisons.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Supplier {
  id        String      @id @default(cuid())
  name      String
  address   String?
  phone     String?
  pattern   BillPattern @default(standard)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  bills            Bill[]
  supplierCashFlow SupplierCashFlow[]

  @@index([name])
  @@map("suppliers")
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  address String?

  // Legacy "current balance" snapshot fields, carried over for display only.
  // The AUTHORITATIVE balance history lives in RetailerBalance — see lib/balance.ts.
  // These are never trusted for calculation, only shown as a convenience label.
  previousBalance      Decimal?  @map("previous_balance") @db.Decimal(12, 2)
  previousBalanceDate  DateTime? @map("previous_balance_date") @db.Date
  previousBalanceNotes String?   @map("previous_balance_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments         Payment[]
  billLineItems    BillLineItem[]
  retailerBalances RetailerBalance[]
  pricingHistory   PricingHistory[]

  @@index([name])
  @@map("customers")
}

model Bill {
  id                 String      @id @default(cuid())
  billNumber         String      @unique @map("bill_number")
  supplierId         String      @map("supplier_id")
  supplier           Supplier    @relation(fields: [supplierId], references: [id])
  date               DateTime    @db.Date
  totalGoatsReceived Int         @default(0) @map("total_goats_received")
  billPattern        BillPattern @default(standard) @map("bill_pattern")
  grandTotal         Decimal     @default(0) @db.Decimal(12, 2) @map("grand_total")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Replaces the old single JSON "distribution" blob (which every reassignment/edit
  // had to parse, mutate, and re-serialize by hand — the exact mechanism behind the
  // "Edit Entries" fragility this session). Each organ/customer line is now a real,
  // individually-addressable, transactionally-editable row.
  lineItems BillLineItem[]

  @@index([supplierId])
  @@index([date])
  @@map("bills")
}

model BillLineItem {
  id         String   @id @default(cuid())
  billId     String   @map("bill_id")
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  organ    String // 'mundi' | 'kaleji' | 'paya' | 'vajdi' | 'gurda'
  quantity Decimal @db.Decimal(10, 2)
  rate     Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(12, 2)

  includesKaleji Boolean @default(false) @map("includes_kaleji")
  includesVajdi  Boolean @default(false) @map("includes_vajdi")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([billId])
  @@index([customerId])
  @@map("bill_line_items")
}

model Payment {
  id         String      @id @default(cuid())
  customerId String      @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  amount     Decimal     @db.Decimal(12, 2)
  date       DateTime    @db.Date
  mode       PaymentMode @default(Cash)
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([date])
  @@map("payments")
}

// Dated closing-balance checkpoints — the single source of truth for
// "previous balance" resolution (see lib/balance.ts). One row per
// customer per mandi period end date; upserted (never duplicated) via
// the unique constraint below, closing the exact "duplicated data"
// failure mode reported in v1.
model RetailerBalance {
  id            String      @id @default(cuid())
  customerId    String      @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  balanceDate   DateTime    @map("balance_date") @db.Date
  balanceAmount Decimal     @map("balance_amount") @db.Decimal(12, 2)
  mandiPeriod   MandiPeriod @map("mandi_period")
  notes         String?
  isManual      Boolean     @default(false) @map("is_manual")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([customerId, balanceDate])
  @@index([customerId])
  @@index([balanceDate])
  @@map("retailer_balances")
}

model PricingHistory {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  organType  String   @map("organ_type")
  rate       Decimal  @db.Decimal(10, 2)
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, organType])
  @@map("pricing_history")
}

model SupplierCashFlow {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  entryType  CashFlowEntryType @map("entry_type")
  date       DateTime          @db.Date
  quantity   Decimal?          @db.Decimal(10, 2)
  rate       Decimal?          @db.Decimal(10, 2)
  amount     Decimal           @db.Decimal(12, 2)
  description String?
  personName String?           @map("person_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([date])
  @@map("supplier_cash_flow")
}
